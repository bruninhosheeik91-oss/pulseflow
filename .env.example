# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shopee Affiliate Open API (backend. Never commit real credentials).
# API_URL default: https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_API_URL=

# Credenciais de afiliados por cliente: NUNCA via .env (ficam cifradas em
# server/data/credentials/<tenant>.json). ENCRYPTION_KEY é a chave do servidor
# usada para cifrar/decifrar esses segredos (hex de 32 bytes = 64 chars).
# Gerar exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Frontend (Vite) ----
# Tenant de DESENVOLVIMENTO para teste REAL local das credenciais Shopee.
# Usado APENAS em modo dev (import.meta.env.DEV) pelo getCurrentTenantId().
# NUNCA defina em produção: builds de produção não usam fallback de
# desenvolvimento. Exemplo de valor local: pulse-dev
VITE_DEV_TENANT_ID=
